# windows minimisation
alias hide='osascript -e '\''tell application "System Events" to keystroke "h" using {command down, option down}'\'
alias mincurr='osascript -e '\''tell application "System Events" to keystroke "m" using {command down, option down}'\'

weather() {
    local location="${1:-}"
    if [ -n "$location" ]; then
        # url encode spaces wth '+'
        location=$(echo "$location" | sed 's/ /+/g')
        curl -s "wttr.in/${location}?m"
    else
        curl -s "wttr.in?m"
    fi
}

