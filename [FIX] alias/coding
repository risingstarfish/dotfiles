alias repos='~/repos'
alias risingstarfish='repos && risingstarfish/'
alias libansi='risingstarfish && libansi/'
alias TransactionManager='risingstarfish && TransactionManager/'
alias PasswordGenerator='risingstarfish && PasswordGenerator/'

alias 'c.'='cursor .'


check_and_delete() {
  if [ ! -d "$1" ]; then
    echo "Warning: '$1' does not exist."
    return 1;
  fi

  rm -rf "$1"
  echo "Successfully deleted $1"
  return 0;
}

# Displays usage information for the 'del' function.
usage_del() {
  echo "Usage: del [flag] [preset_names...]"
  echo "Deletes specified directories within a Git repository."
  echo "All paths are relative to the repository root."
  echo
  echo "Flags:"
  echo "  (no flag)      Deletes 'out/build/*/bin/' (all preset bin folders)."
  echo "  -u, --bin      Deletes all preset bin folders. Can be followed by specific"
  echo "                 preset names to target only those (e.g., del --bin gcc-debug)."
  echo "  -o, --out      Deletes the entire 'out/' directory."
  echo "  -b, --build    Deletes the 'out/build/' directory."
  echo "  -c, --ccache   Deletes the 'out/.ccache' directory."
  echo
  echo "*Note*: Flags can be combined (e.g., del -b -c)."
  echo "        but once -o or --out is used, the function exits after deleting 'out/'"
  echo "        as there are no further directories to check."
}

# Recursively deletes all bin/ directories under out/build/*/
del_bin() {
  local dir_path="$1"
  shift

# Case 1: Specific preset names were provided.
  if (( $# > 0 )); then
    for preset_name in "$@"; do
      check_and_delete "$dir_path/out/build/$preset_name/bin"
    done
    return 0
  fi

  # Case 2: No preset names, delete all 'bin/' directories.
  local bin_dirs=("$dir_path/out/build/"*/bin(N)) # Using zsh globbing to find all bin/ dirs.

  if (( ${#bin_dirs[@]} == 0 )); then
    echo "Warning: No 'bin/' directories found in '$dir_path/out/build/'."
    return 1
  fi

  for dir in "${bin_dirs[@]}"; do
    check_and_delete "$dir"
  done

  return 0
}


# Deletes specified directories within a Git repository.
# Safety check: Ensures the command is run inside a Git repository.
# If not in a Git repository, it aborts to prevent accidental deletions.
# Behavior:
# 1. No arguments: Deletes 'out/build/presetName/bin/' relative to the repo root.
# 2. With arguments: Accepts specific flags to delete certain directories.
#    Acceptable flags:
#    (no flag) or -u or --bin: Deletes 'out/build/presetName/bin/'
#     -o or --out: Deletes 'out/'.
#     -b or --build: Deletes 'out/build/'
#     -c or --ccache: Deletes 'out/.ccache'
#     *Note*: Flags can be combined, and any unknown flag results in an
#             error message and usage instructions.
del() {
  # --- Safety Check ---
  # 1. Get the top-level directory of the Git repository.
  #    This command will fail if not inside a Git repository.
  local git_root
  git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ $? -ne 0 ]; then
    echo "Error: Not in a Git repository. Aborting to prevent accidental deletion." >&2
    return 1
  fi   
  
  # --- Behavior 1: No arguments ---
  # If no arguments are provided, delete 'out/build/presetName/bin/' relative to the repo root.
  if [ $# -eq 0 ]; then
    del_bin "$git_root"
    return $?
  fi

  # --- Behavior 2: Arguments are provided ---
  # Process each argument and delete the corresponding directory.
  while (( $# > 0 )); do
    case "$1" in
      -o|--out)
        if check_and_delete "$git_root/out/"; then
          return 0; # Exit after deleting 'out/' to prevent further unnecessary checks
        fi
        # Skip in case there are additional flags
        echo "Skipping..."
        shift
        ;;
      -b|--build)
        check_and_delete "$git_root/out/build"
        shift
        ;;
      -c|--ccache)
        check_and_delete "$git_root/out/.ccache"
        shift
        ;;
      -u|--bin)
        shift
        local presets=()
        while [[ -n "$1" && "$1" != -* ]]; do
          presets+=("$1")
          shift
        done

        del_bin "$git_root" "${presets[@]}"
        ;;
      *)
        usage_del
        return 1
        ;;
    esac
  done
}

alias delo='del --out'
alias delb='del --build'
alias delc='del --ccache'
alias delu='del --bin'

