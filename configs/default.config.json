{
    "$schema": "../schemas/config.schema.json",
    "version": "1.0",
    "env": "unknown",
    "language": "english-uk",
    "environment": {
        "DOTFILES_LOG_DIR": "${HOME}/.config/dotfiles/logs",
        "DOTFILES_CACHE_DIR": "${HOME}/.cache/dotfiles",
        "DOTFILES_LOG": true,
        "DOTFILES_LOCAL_MODS": false,
        "DOTFILES_AUTORESTART": false,
        "DOTFILES_IGNORE_HANDOFF": false
    },
    "colour": "auto",
    "max_backups": 10,
    "logging": {
        "initialise": {
            "enabled": true,
            "quiet": true,
            "path": "${DOTFILES_LOG_DIR}/init.log",
            "log_level": "trace",
            "log_size_mb": 0
        },
        "main": {
            "enabled": true,
            "quiet": false,
            "path": "${DOTFILES_LOG_DIR}/main.log",
            "log_level": "info",
            "log_size_mb": 0,
            "time": true
        }
    },
    "modules": {
        "zsh": true,
        "pwsh": true,
        "bash": true,
        "git": true,
        "ssh": true,
        "dev": true,
        "topgrade": true,
        "fastfetch": true,
        "tmux": true,
        "curl": true,
        "wget": true,
        "shellcheck": true,
        "claude": true,
        "oh-my-posh": true
    },
    "files": {
        "zsh/zshrc": true,
        "zsh/zsh_options": true,
        "zsh/zstyles": true,
        "zsh/zimrc": true,
        "zsh/p10k.zsh": true,
        "zsh/zshrc.toggles": true,
        "zsh/Set-MSVC-Environment": true,
        "zsh/exports": true,
        "zsh/paths": true,
        "zsh/functions": true,
        "zsh/aliases": true,
        "bash/bashrc": true,
        "pwsh/Profile": true,
        "pwsh/Functions": true,
        "pwsh/Set-MSVC-Environment": true,
        "git/gitconfig": true,
        "git/gitignore": true,
        "git/gitattributes": true,
        "git/diff-so-fancy": true,
        "ssh/config": true,
        "ssh/allowed_signers": true,
        "dev/cmakepreset.py": true,
        "dev/internal-flags.cmake": true,
        "dev/cmake-format.py": true,
        "dev/clang-format": true,
        "dev/clang-tidy": true,
        "dev/editorconfig": true,
        "topgrade/topgrade.toml": true,
        "fastfetch/config.jsonc": true,
        "tmux/tmux.conf": true,
        "curl/curlrc": true,
        "wget/wgetrc": true,
        "shellcheck/shellcheckrc": true,
        "claude/settings.json": true,
        "claude/plugins.json": true,
        "oh-my-posh/themes": true
    }
}
