{
  "version": 1.0,
  "repository": "https://github.com/risingstarfish/dotfiles.git",
  "dependencies": [
    {
      "name": "sudo",
      "priority": "required",
      "install": {
        "windows-ps": {
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./windows_scripts/enable-sudo.ps1\"",
          "run_as_root": true,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "scoop",
      "priority": "required",
      "install": {
        "windows-ps": {
          "command": "cd C:\\; Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force; Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "libsecret",
      "priority": "required",
      "install": {
        "archlinux": {
          "command": "pacman -S libsecret",
          "run_as_root": true,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "ms-build-tools",
      "priority": "required",
      "install": {
        "windows-ps": {
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./windows_scripts/install-msvc.ps1\"",
          "run_as_root": true,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "gpg",
      "priority": "required",
      "install": {
        "macos": {
          "command": "brew install gnupg",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S gnupg",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "scoop install gnupg",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "curl",
      "priority": "required",
      "install": {
        "macos": {
          "command": "brew install curl",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S curl",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "scoop install curl",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "wget",
      "priority": "required",
      "install": {
        "macos": {
          "command": "brew install wget",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S wget",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "scoop install wget",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "yay",
      "priority": "required",
      "install": {
        "archlinux": {
          "command": "mkdir -p $HOME/installs; cd $HOME/installs; sudo pacman -S --needed git base-devel; git clone https://aur.archlinux.org/yay.git; cd yay; makepkg -si",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "git",
      "priority": "required",
      "install": {
        "macos": {
          "command": "brew install git",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S git",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./windows_scripts/install-git.ps1\"",
          "run_as_root": true,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "nano",
      "priority": "required",
      "install": {
        "macos": {
          "command": "brew install nano",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S nano",
          "run_as_root": true,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "docker",
      "priority": "required",
      "install": {
        "macos": {
          "command": "FIXME:",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "FIXME:",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "FIXME:",
          "run_as_root": true,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "zsh",
      "priority": "required",
      "install": {
        "macos": {
          "command": "brew install zsh",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S zsh",
          "run_as_root": true,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "fastfetch",
      "priority": "optional",
      "install": {
        "macos": {
          "command": "brew install fastfetch",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S fastfetch",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "scoop install fastfetch",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "eza",
      "priority": "optional",
      "install": {
        "macos": {
          "command": "brew install eza",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S eza",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "scoop install eza",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "fzf",
      "priority": "optional",
      "install": {
        "macos": {
          "command": "brew install fzf",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S fzf",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "scoop install fzf",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "zoxide",
      "priority": "optional",
      "install": {
        "macos": {
          "command": "brew install zoxide",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S zoxide",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "scoop install zoxide",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "nvim",
      "priority": "optional",
      "install": {
        "macos": {
          "command": "brew install neovim",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S neovim",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "scoop install neovim",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "ssh",
      "priority": "required",
      "install": {
        "archlinux": {
          "command": "pacman -S openssh",
          "run_as_root": true,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "rustup",
      "priority": "optional",
      "install": {
        "macos": {
          "command": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "topgrade",
      "priority": "optional",
      "install": {
        "macos": {
          "command": "brew install topgrade",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "pacman -S topgrade",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "scoop bucket add main; scoop install main/topgrade",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    },
    {
      "name": "codium-insiders",
      "priority": "optional",
      "install": {
        "macos": {
          "command": "brew install --cask vscodium@insiders",
          "run_as_root": false,
          "ignore_errors": false
        },
        "archlinux": {
          "command": "yay -S --needed --noconfirm vscodium-insiders-bin",
          "run_as_root": true,
          "ignore_errors": false
        },
        "windows-ps": {
          "command": "winget install -e --id VSCodium.VSCodium.Insiders",
          "run_as_root": false,
          "ignore_errors": false
        }
      }
    }
  ],
  "modules": [
    {
      "name": "core",
      "directory": "core",
      "files": [
        {
          // NOTE: Keep first
          "source": "exports", // input filename relative to dotfiles dir
          "target": "~/.exports", // output filename
          // alias: all, unix ["archlinux", "macos", "windows-ps", "windows-bash"],
          "platform": "all",
          "mode": "symlink" // [symlink,copy]
        },
        {
          "source": "paths",
          "target": "~/.paths",
          "platform": "all",
          "mode": "symlink"
        },
        {
          "source": "aliases",
          "target": "~/.aliases",
          "platform": "all",
          "mode": "symlink"
        },
        {
          "source": "functions",
          "target": "~/.functions",
          "platform": "all",
          "mode": "symlink"
        },
        {
          "source": "git_functions",
          "target": "~/.git_functions",
          "platform": "all",
          "mode": "symlink"
        }
      ]
    },
    {
      "name": "win-zsh-setup",
      "directory": "bash",
      "files": [
        {
          "source": "bash_profile",
          "target": "~/.bash_profile",
          "platform": "windows-bash",
          "mode": "copy"
        },
        {
          "source": "bashrc",
          "target": "~/.bashrc",
          "platform": "windows-bash",
          "mode": "copy"
        }
      ]
    },
    {
      "name": "utils",
      "directory": "utils",
      "files": [
        {
          "source": "curlrc",
          "target": "~/.curlrc",
          "platform": "all",
          "mode": "symlink"
        },
        {
          "source": "wgetrc",
          "target": "~/.wgetrc",
          "platform": "all",
          "mode": "symlink"
        },
        {
          "source": "aerospace.toml",
          "target": "~/.aerospace.toml",
          "platform": "macos",
          "mode": "symlink"
        }
      ]
    },
    {
      "name": "zsh",
      "directory": "zsh",
      "files": [
        {
          "source": "zshrc",
          "target": "~/.zshrc",
          "platform": "unix",
          "mode": "symlink"
        },
        {
          "source": "zsh_options",
          "target": "~/.zsh_options",
          "platform": "unix",
          "mode": "symlink"
        },
        {
          "source": "zimrc",
          "target": "~/.zimrc",
          "platform": "unix",
          "mode": "symlink"
        },
        {
          "source": "p10k.zsh",
          "target": "~/.p10k.zsh",
          "platform": "unix",
          "mode": "symlink"
        },
        {
          "source": "zstyles",
          "target": "~/.zstyles",
          "platform": "unix",
          "mode": "symlink"
        }
      ]
    },
    {
      "name": "git",
      "directory": "git",
      "files": [
        {
          "source": "gitignore",
          "target": "~/.gitignore_global",
          "platform": "all",
          "mode": "symlink"
        },
        {
          "source": "gitconfig",
          "target": "~/.gitconfig_global",
          "platform": "all",
          "mode": "symlink"
        },
        {
          "source": "gitattributes",
          "target": "~/.gitattributes_global",
          "platform": "all",
          "mode": "symlink"
        }
      ]
    },
    {
      "name": "nvim",
      "directory": "utils",
      "files": [
        {
          "source": "nvim",
          "target": "~/.config/nvim",
          "platform": "all",
          "mode": "symlink"
        }
      ]
    },
    {
      "name": "topgrade",
      "directory": "utils",
      "files": [
        {
          "source": "topgrade.toml",
          "target": "~/.config/topgrade.toml",
          "platform": "all",
          "mode": "symlink"
        }
      ]
    },
    {
      "name": "fastfetch",
      "directory": "utils",
      "files": [
        {
          "source": "fastfetch/config.jsonc",
          "target": "~/.config/fastfetch/config.jsonc",
          "platform": "all",
          "mode": "symlink"
        }
      ]
    },
    {
      "name": "editorconfig",
      "directory": "utils",
      "files": [
        {
          "source": "editorconfig",
          "target": "~/.editorconfig",
          "platform": "all",
          "mode": "symlink"
        }
      ]
    }
  ]
}
