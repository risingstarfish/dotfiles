#!/usr/bin/env bash
# allowed_signers.gen
# Generates/appends to ~/.ssh/allowed_signers from the user's SSH signing key.
# Run by the dotfiles installer via: bash <this_file>

set -euo pipefail

readonly SIGN_KEY="${HOME}/.ssh/id_ed25519_github_sign"
readonly SIGN_KEY_PUB="${SIGN_KEY}.pub"
readonly DEST="${HOME}/.ssh/allowed_signers"

# helper
err() {
	printf 'Error: %s\n' "$1" >&2
}

# Detects whether the user has a github_ssh_key function
# defined in their shell config. Prints the config file path to stdout.
# Returns 0 if found, 1 if not.
detect_github_key_fn() {
	local -r file="${HOME}/.functions"
	[[ -f "${file}" ]] || return 1
	if ! grep -qE '^[[:space:]]*(function[[:space:]]+)?github_ssh_key[[:space:]]*\(' "${file}" 2>/dev/null; then
		return 1
	fi

	printf '%s' "${file}"
}

# key detection
if [[ ! -f "${SIGN_KEY_PUB}" ]]; then
	printf '\n'
	printf 'Signing key not found: %s\n' "${SIGN_KEY_PUB}"
	printf '\n'

	detected_rc=""
	if detected_rc="$(detect_github_key_fn)"; then
		printf '  Detected github_ssh_key() in %s\n' "${detected_rc##*/}"
		printf '\n'
	fi

	printf 'To generate the signing key, run:\n'
	printf '  ssh-keygen -t ed25519 -f %s -N "" -C "signing"\n' "${SIGN_KEY}"
	printf '\n'
	printf '  This key is separate from your main GitHub auth key.\n'
	printf '  It is used only for GPG signing of commits.\n'
	printf '\n'
	printf 'Do you want to generate it now? [y/N]: '
	read -r choice || choice="n"

	case "${choice}" in
	[yY])
		printf 'Generating signing key…\n'
		if ! ssh-keygen -t ed25519 -f "${SIGN_KEY}" -N "" -C "signing"; then
			err "ssh-keygen failed. Generate the key manually, then re-run the installer."
			exit 1
		fi
		printf '  Created: %s\n' "${SIGN_KEY_PUB}"
		;;
	*)
		err "Signing key is required for allowed_signers. Generate it first, then re-run the installer."
		exit 1
		;;
	esac
fi

# email
email="$(git config --get user.email 2>/dev/null)" || true
if [[ -z "${email}" ]]; then
	err "git user.email is not set."
	printf '  Set it with: git config --global user.email "you@example.com"\n'
	exit 1
fi

mkdir -p "$(dirname "${DEST}")" || {
	err "Unable to create ~/.ssh"
}

# avoid duplicate entries
if [[ -f "${DEST}" ]] && grep -qF "${email} namespaces=\"git\"" "${DEST}" 2>/dev/null; then
	printf '  [skip] %s (entry for %s already present)\n' "${DEST}" "${email}"
	exit 0
fi

printf '%s namespaces="git" %s\n' "${email}" "$(cat "${SIGN_KEY_PUB}")" >>"${DEST}"
chmod 600 "${DEST}"

printf '  [generated] %s\n' "${DEST}"
exit 0
