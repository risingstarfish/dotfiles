diff --git a/FATCATMain/basic.h b/FATCATMain/basic.h
index b8739a6..95496f1 100644
--- a/FATCATMain/basic.h
+++ b/FATCATMain/basic.h
@@ -18,4 +18,37 @@
 #define SSDIS   -4.0
 #define PVALUE  0.25
 using namespace std;
+
+//------------------------------------------------------------------
+//PDB-parsing error contract.
+//Shared by PROT::AssignPdb, the AFPCHAIN constructor (FATCAT/FATCAT2Tree),
+//and POSTALIGN::ReadPdb/ReadFastaAln/ReadClustalAln (PostFATCAT).
+//A PdbErr code carries *what* went wrong; the line number where parsing
+//failed (if any) is carried separately by each class as an int
+//(PROT::GetErrLine / AFPCHAIN::GetErrLine / POSTALIGN::GetErrLine),
+//not encoded into this enum.
+//------------------------------------------------------------------
+enum PdbErr	{
+	PDB_OK = 0,	//no error, parsing succeeded
+	PDB_NOFILE,	//the input file could not be opened
+	PDB_MALFORMED,	//a record could not be parsed as expected (bad/short columns)
+	PDB_TRUNCATED,	//the file ended before any/enough usable data was read
+	PDB_TOO_LONG,	//a line exceeded the MAXLEN cap, or the file is otherwise oversized
+	PDB_ALLOC	//a memory allocation failed while parsing
+};
+
+//map a PdbErr code to a short, fixed, human readable message
+inline const char* PdbErrStr(PdbErr code)
+{
+	switch(code)	{
+		case PDB_OK:		return "ok";
+		case PDB_NOFILE:	return "could not open file";
+		case PDB_MALFORMED:	return "malformed pdb record";
+		case PDB_TRUNCATED:	return "truncated pdb file (unexpected end of file)";
+		case PDB_TOO_LONG:	return "oversized pdb input (line or file exceeds MAXLEN)";
+		case PDB_ALLOC:		return "memory allocation failed";
+		default:		return "unknown pdb error";
+	}
+}
+
 #endif
