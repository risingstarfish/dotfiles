{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/risingstarfish/dotfiles/schemas/modules.schema.json",
    "title": "Dotfiles Modules",
    "description": "Schema for dotfiles user modules file. Module names are open-ended: every key under 'modules' must match a directory in modules/, which the installer checks at runtime.",
    "type": "object",
    "$defs": {
        "os_name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "os_list": {
            "type": "array",
            "items": { "$ref": "#/$defs/os_name" },
            "minItems": 1,
            "uniqueItems": true
        },
        "path_map": {
            "type": "object",
            "minProperties": 1,
            "properties": { "default": { "type": "string", "minLength": 1 } },
            "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "file_type": {
            "type": "string",
            "enum": ["symlink", "copy", "generate"]
        },
        "file_entry": {
            "type": "object",
            "description": "A single file (or directory) to install",
            "properties": {
                "enabled": { "type": "boolean", "default": true },
                "available": { "$ref": "#/$defs/os_list" },
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "source": { "type": "string", "minLength": 1 },
                "destination": {
                    "anyOf": [
                        { "type": "string", "minLength": 1 },
                        { "$ref": "#/$defs/path_map" }
                    ]
                },
                "type": { "$ref": "#/$defs/file_type" },
                "post_install": {
                    "description": "Post-install shell command, or an empty string when none",
                    "type": "string",
                    "default": ""
                }
            },
            "required": [
                "name",
                "description",
                "source",
                "destination",
                "type"
            ],
            "additionalProperties": false
        },
        "module": {
            "type": "object",
            "description": "A standard flat dotfiles module",
            "properties": {
                "enabled": { "type": "boolean", "default": true },
                "available": { "$ref": "#/$defs/os_list" },
                "files": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/file_entry" }
                }
            },
            "required": ["files"],
            "additionalProperties": false
        }
    },
    "properties": {
        "$schema": {
            "description": "Editor hint pointing at this schema; ignored at install time",
            "type": "string"
        },
        "version": {
            "description": "Dotfiles modules schema version",
            "type": "string",
            "enum": ["1.0"]
        },
        "os_list": {
            "$ref": "#/$defs/os_list"
        },
        "modules": {
            "type": "object",
            "description": "Map of module name to module definition. Every key must match a directory in modules/.",
            "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "additionalProperties": { "$ref": "#/$defs/module" }
        }
    },
    "required": ["version", "os_list", "modules"],
    "additionalProperties": false
}
