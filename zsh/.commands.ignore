check_home_dir() {
    # Get absolute paths for comparison
    local current_dir=$(realpath "$PWD")
    local home_dir=$(realpath "$HOME")
   
    # Check if current directory is within the home directory tree
    if [[ "$current_dir" != "$home_dir" && "$current_dir" != "$home_dir"/* ]]; then
        # Prompt the user for confirmation
        echo "⚠️  Warning: You are not in your home directory ($HOME) or its subdirectories."
        read -k 1 "choice?Are you sure you want to proceed? (y/n) "
        echo

        # If the user's choice is NOT 'y' or 'Y', cancel the operation
        if [[ ! "$choice" =~ ^[Yy]$ ]]; then
            echo "Operation cancelled." >&2
            return 1
        fi

        echo "Continuing..."
    fi
}

create_rubbish_dir() {
    # check for arguments
    if [ "$#" -ne 0 ]; then
        echo "Usage: create_rubbish_dir" >&2
        return 1
    fi

    echo "Rubbish directory does not exist."
       
    mkdir -p "$HOME/.Rubbish"
    # check if mkdir failed
    if [ $? -ne 0 ]; then
        echo "Error: Failed to create rubbish directory at $HOME/.Rubbish" >&2
        return 1
    fi
    echo "Created rubbish directory at $HOME/.Rubbish"
}

#TODO add options
safe_rm() {
    # Check if any arguments were provided
    if [ "$#" -eq 0 ]; then
        echo "Usage: safe_rm [options] <file_or_directory1>  [<file_or_directory2> ...]" >&2
        return 1
    fi

    if ! check_home_dir; then
        return 0
    fi


    # Ensure the rubbish directory exists
    if [ ! -d "$HOME/.Rubbish" ]; then
        create_rubbish_dir
    fi

    # disable shell execution tracing
    setopt localoptions NO_XTRACE NO_VERBOSE
   
    local rubbish_dir="$HOME/.Rubbish"

    # Loop through all arguments (files/directories to be "deleted")
    for item in "$@"; do
        # Check if the file/directory actually exists
        if [ ! -e "$item" ]; then
            echo "safe_rm: cannot remove '$item': No such file or directory. Skipping..." >&2

            continue
        fi

        # check if it begins with a '.'
        if [[ "$item" == .* ]]; then
            # prompt user to remove hidden files/directories
            echo "Hidden file/directory detected: '$item'"
            read -k 1 "REPLY?Are you sure you want to remove it? (y/n): "
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                echo "Skipping..."
                continue
            fi
        fi

        # Get the absolute path of the item
        local original_path=$(realpath -- "$item")
        # Create a unique name for the item in the rubbish to avoid collisions
        local rubbished_name="$(basename "$item")-$(date +%Y%m%d%H%M%S)-$(openssl rand -hex 4)"

        # Store the original path in an info file
        echo "$original_path" > "$rubbish_dir/$rubbished_name.info"
        if [ $? -ne 0 ]; then
            echo "Error: Failed to create info file for '$item'. Skipping..." >&2
            continue
        fi

        # Move the item to the rubbish directory
        mv "$item" "$rubbish_dir/$rubbished_name"
        if [ $? -ne 0 ]; then
            echo "Error: Failed to move '$item' to rubbish. Skipping..." >&2

            # delete the info file
            rm "$rubbish_dir/$rubbished_name.info"
            if [ $? -ne 0 ]; then
                echo "Error: Failed to delete info file for '$item'." >&2
                continue
            fi

            echo "Deleted info file for '$item'."
            continue
        fi

        echo "Moved to rubbish: '$item'"
    done
}


# --- undo_rm Function ---
# Restores a file from the ~/.Rubbish directory back to its original location.
# If the original directory doesn't exist, prompts user to create it
undo_rm() {
    # TODO: restoring multiple files at once by fzf and cli
    # TODO: add argument support
    # check for arguments
    if [ "$#" -ne 0 ]; then
        echo "Usage: undo_rm" >&2
        return 1
    fi

    # Ensure the rubbish directory exists
    if [ ! -d "$HOME/.Rubbish" ]; then
        create_rubbish_dir
        return 0
    fi

    local rubbish_dir="$HOME/.Rubbish"

    # Check if the rubbish directory is empty
    if [ -z "$(ls -A $rubbish_dir)" ]; then
        echo "Rubbish is empty."
        return 0
    fi

    # list all files in rubbish directory except *.info and .DS_Store files
    local file_to_restore=$(ls -1A ~/.Rubbish | grep -ve '\.info$' -e '.DS_Store' | fzf --prompt="Select a file to restore> " --header="Press CTRL-C to cancel")
    
    # Exit if no file was selected (e.g., user pressed Ctrl-C)
    if [ -z "$file_to_restore" ]; then
        echo "No file selected. Aborting."
        return 0
    fi

    local info_file_path="$rubbish_dir/$file_to_restore.info"
    # Check if the info file exists
    if [ ! -f "$info_file_path" ]; then
        echo "Error: Could not find metadata for '$file_to_restore'. Aborting..." >&2
        return 1
    fi

    # Read the original path from the info file
    local original_path=$(cat "$info_file_path")
    if [ $? -ne 0 ]; then
        echo "Error: Failed to read info file for '$file_to_restore'. Aborting..." >&2
        return 1
    fi

    local original_dir=$(dirname "$original_path")
    if [ $? -ne 0 ]; then
        echo "Error: Failed to get directory name for '$original_path'. Aborting..." >&2
        return 1
    fi

    local original_filename=$(basename "$original_path")
    if [ $? -ne 0 ]; then
        echo "Error: Failed to get filename for '$original_path'. Aborting..." >&2
        return 1
    fi

    # --- Confirmation Step ---
    read -k 1 "REPLY?Are you sure you want to restore '$original_filename' to '$original_dir'? (y/n): "
    echo

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Restore cancelled."
        return 0
    fi
        
    # Check if a file/dir with the same name already exists at the destination
    if [ -e "$original_path" ]; then
        echo "Error: A file or directory already exists at the destination '$original_path'." >&2
        echo "Please move or rename it first." >&2
        return 1
    fi

    # Check if the original directory exists. If not, ask the user what to do.
    local target_path
    if [ ! -d "$original_dir" ]; then
        echo "Original directory '$original_dir' does not exist."
        read -k 1 "REPLY?Do you want to re-create it? (y/n): "
        echo

        if [[ $REPLY =~ ^[Yy]$ ]]; then
            mkdir -p "$original_dir"
            if [ $? -ne 0 ]; then
                echo "Error: Failed to create original directory '$original_path'. Aborting..." >&2
                return 1
            fi

            echo "Re-created target directory '$original_dir'."
            target_dir="$original_dir"
            target_path="$original_dir/$original_filename"
        else 
            # prompt user to create new directory
            read -r "new_dir?Enter a directory to restore '$original_filename' to (leave blank to cancel): "

            if [ -z "$new_dir" ]; then
                echo "Restore cancelled."
                return 0
            fi

            # check if new directory does not exist
            if [ ! -d "$new_dir" ]; then
                # create new directory
                mkdir -p "$new_dir"
                if [ $? -ne 0 ]; then
                    echo "Error: Failed to create new directory '$new_dir'." >&2
                    return 1
                fi
                echo "Created new directory '$new_dir'."
            else
                echo "Directory '$new_dir' already exists. Continuing..."
            fi
            target_dir="$new_dir"
            target_path="$new_dir/$original_filename"
        fi
    else
        # original directory exists
        target_dir="$original_dir"
        target_path="$original_path"
    fi 
    
    # Check for a collision in the new location
    if [ -e "$target_path" ]; then
        echo "Error: A file already exists at the new destination '$target_path'. Aborting..." >&2
        return 1
    fi

    # Clean up the info file
    rm "$info_file_path"
    if [ $? -ne 0 ]; then
        echo "Error: Failed to delete info file for '$file_to_restore'. Aborting..." >&2
        return 1
    fi

    # Move the file back to the determined path
    mv "$rubbish_dir/$file_to_restore" "$target_path"
    if [ $? -ne 0 ]; then
        echo "Error: Failed to move '$file_to_restore' to '$target_path'. Aborting..." >&2
        return 1
    fi

    echo "Successfully restored '$original_filename' to '$(realpath -- "$target_dir")'"
}

# --- empty_rubbish Function ---
# Permanently deletes all files and folders from the rubbish directory.
#TODO: add option to empty specific files/directories 
# empty_rubbish -f file1 file2
# empty_rubbish *.cpp *.hpp file1 
empty_rubbish() {
    # check for arguments
    if [ "$#" -ne 0 ]; then
        echo "Usage: empty_rubbish" >&2
        return 1
    fi

    local rubbish_dir="$HOME/.Rubbish"
    # Ensure the rubbish directory exists
    if [ ! -d "$rubbish_dir" ]; then
        create_rubbish_dir
        return
    fi

    # Do not query user before executing rm * or rm path/*
    setopt localoptions rmstarsilent

    # Check if the rubbish directory is not empty
    if [ -z "$(ls -A "$rubbish_dir")" ]; then
        echo "Rubbish is already empty."
        return
    fi

    # --- Confirmation Step ---
    echo "This will permanently delete all items in your rubbish."
    read -k 1 "REPLY?Are you sure you want to continue? (y/n): "
    echo

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "Emptying the rubbish..."
        # Delete the contents of the rubbish directory
        command rm -rf "$rubbish_dir"/* 2>/dev/null
        echo "Rubbish has been emptied."
    else
        echo "Operation cancelled."
    fi
}

# do not list .info files or .DS_Store files
# TODO add option to list specific files/directories
# list_rubbish -f file1 file2 *.cpp 
list_rubbish() {
    # check for arguments
    if [ "$#" -ne 0 ]; then
        echo "Usage: list_rubbish" >&2
        return 1
    fi

    if [ -z "$(ls -A ~/.Rubbish)" ]; then
        echo "Rubbish is empty."
        return
    fi

    ls -1A ~/.Rubbish | grep -ve '\.info$' -e '.DS_Store'
}

#TODO add options
safe_mv() {
    # check for arguments
    if [ "$#" -lt 2 ]; then
        echo "Usage: safe_mv [options] <source1> [<source2> ...] <destination>" >&2
        return 1
    fi

    if ! check_home_dir; then
        return 0
    fi

    # check if destination exists by checking final argument
    local destination="${@: -1}"
    if [ ! -d "$destination" ]; then
        echo "Error: Destination directory '$destination' does not exist." >&2
        return 1
    fi

    # loop through all sources
    local sources=("${@: 1: -1}")
    for source in "${sources[@]}"; do
        # check if source exists
        if [ ! -e "$source" ]; then
            echo "Error: Source file/directory '$source' does not exist. Skipping..." >&2
            continue
        fi

        mv "$source" "$destination"
        if [ $? -ne 0 ]; then
            echo "Error: Failed to move '$source' to '$destination'. Skipping..." >&2
            continue
        fi
        echo "Moved '$source' to '$destination'"
    done
}

