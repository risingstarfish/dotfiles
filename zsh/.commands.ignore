# --- safe_cp Function ---
# A wrapper for 'cp' that prompts the user before overwriting files.
# It correctly handles flags (like -r) and multiple sources.
# TODO find a way to put into one loop. currently cannot since you need to parse all the flags first,
# and they can be entered anywhere (besides last) in the arguments (e.g. safe_cp source -r destination)
safe_cp() {
    # Print usage if not enough arguments
    if [ "$#" -lt 2 ]; then
        echo "-----------------------------------------------------------------------------------------------------------------------------------" >&2
        echo "Usage: safe_cp [options] <sourceN> ... <sourceM> <destination>" >&2
        echo "       safe_cp [options] -- <sourceN> ... <sourceM> <destination>" >&2
        echo "-----------------------------------------------------------------------------------------------------------------------------------" >&2
        echo "Note:  '-i' or '--interactive' should not be used. Interactive mode is automatically implemented within the function." >&2
        echo "       '--' is used to separate flags from the rest if there are sources/destination uses characters such as '-' in the name." >&2
        echo "       '--' is unnecessary if there are no flags, but you can still use it." >&2
        echo "-----------------------------------------------------------------------------------------------------------------------------------" >&2
        echo "E.g.   VALID:   safe_cp <sourceN> [options] <destination>" >&2
        echo "       VALID:   safe_cp <sourceN> [options] -- <destination>" >&2
        echo "       VALID:   safe_cp [options] -- <sourceN> ... <sourceM> <destination>" >&2
        echo "       INVALID: safe_cp -- [options] <sourceN> <destination>" >&2
        echo "       INVALID: safe_cp <sourceN> -- <sourceM> [options] <destination>" >&2
        echo "       tldr: flags MUST come before '--' and sources/destination MUST come after '--'." >&2
        echo "-----------------------------------------------------------------------------------------------------------------------------------" >&2

        return 1
    fi


    if ! check_home_dir; then
        return 0
    fi

    local abs_destination=$(realpath -- "${@: -1}")
    if [ ! -d "$abs_destination" ]; then
        echo "Error: Destination directory '$abs_destination' does not exist." >&2

        # prompt user to create destination
        read -k 1 "REPLY?Do you want to create it? (y/n): "
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            mkdir -p "$abs_destination"
            echo "Created destination directory '$abs_destination'"
            if [ $? -ne 0 ]; then
                echo "Error: Failed to create destination directory '$abs_destination'" >&2
                return 1
            fi
        else
            echo "Operation cancelled."
            return 0
        fi
        echo
    fi

    local sources=()
    local flags=()
    # loop through all arguments
    for arg in "${@: 1: -1}"; do
        if [[ "$arg" == --* ]]; then
            # check if flag is valid using cp --help
            if ! cp --help | grep -q -- "$arg"; then
                echo "Warning: '$arg' is not a valid flag. Skipping..." >&2
                echo
                continue
            fi
            # Long flag (e.g., --recursive)
            if [[ "$arg" == "--interactive" ]]; then
                echo "Warning: '--interactive' should not be used. Interactive mode is automatically implemented. Skipping..." >&2
                echo
                continue
            fi

            flags+=("$arg")
        elif [[ "$arg" == -* ]]; then
            # Short flag(s), e.g., -r, -i, -ri
            flagstr="${arg#-}"  # Remove leading dash
            for ((i=0; i<${#flagstr}; i++)); do
                char="${flagstr:$i:1}"

                #check if flag is valid using cp --help
                if ! cp --help | grep -q -- " -$char"; then # intentionally add a space before to not match with hyphenated words
                    echo "Warning: '$char' is not a valid flag. Skipping..." >&2
                    echo
                    continue
                fi

                if [[ "$char" == "i" ]]; then
                    echo "Warning: '-i' should not be used. Interactive mode is automatically implemented. Skipping..." >&2
                    echo
                    continue
                fi
               
                # valid flag
                flags+=("-$char")
            done
        else
            # Not a flag, treat as source
            local abs_source=$(realpath -- "$arg")
            if [ ! -e "$abs_source" ]; then
                echo "Warning: Source '$abs_source' does not exist. Skipping..." >&2
                echo
                continue
            fi

            # check if source is the same as destination
            if [ "$abs_source" = "$abs_destination" ]; then
                echo "Warning: Source '$abs_source' is the same as destination. Skipping..." >&2
                echo
                continue
            fi

            sources+=("$abs_source")
        fi
    done

    for source in "${sources[@]}"; do
        local abs_source=$(realpath -- "$source")
        local target="$abs_destination/$(basename "$source")"

        if [ -e "$target" ]; then
            read -k 1 "REPLY?'$target' already exists. Move original file to rubbish? (y/n): "
            echo

            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                echo "Skipped '$source'"
                echo

                continue
            fi
            safe_rm "$target"
        fi
           
        cp "${flags[@]}" "$abs_source" "$abs_destination"

        if [ $? -ne 0 ]; then
            echo "Error: Failed to copy '$abs_source' to '$abs_destination'" >&2
            echo
        else
            echo "Copied '$abs_source' to '$abs_destination'"
            echo
        fi
    done          
}


make_directory_and_touch() {
    # check for arguments
    if [ "$#" -lt 2 ]; then
        echo "Usage: make_and_touch <directory> <source1> [<sourceN> ...]" >&2
        return 1
    fi

    if ! check_home_dir; then
        return 0
    fi

    local directory="$1"
    local sources=("${@: 2}")

    #check if directory exists
    if [ ! -d "$directory" ]; then
        mkdir -p "$directory"
        if [ $? -ne 0 ]; then
            echo "Error: Failed to create directory '$directory'." >&2
            return 1
        fi
    else
        echo "Directory '$directory' already exists."
    fi

    #touch all sources
    for source in "${sources[@]}"; do
        # check if source exists in target directory
        if [ -e "$directory/$source" ]; then
            echo "'$source' already exists in '$directory'. Skipping..."
            continue
        else
            touch "$directory/$source"
            if [ $? -ne 0 ]; then
                echo "Error: Failed to touch '$source'." >&2
                continue
            fi
            echo "Created '$directory/$source'"
        fi
    done
    # TODO: maybe add back an option to delete and recreate
            # # prompt user to overwrite
            # read -k 1 "REPLY?'$source' already exists in '$directory'. Delete? (y/n): "
            # echo
            # if [[ $REPLY =~ ^[Yy]$ ]]; then
            #     # delete
            #     safe_rm "$directory/$source"
            # else
            #     echo "Skipping '$source'"
            #     continue
            # fi
       
}

make_directory() {
    # check for arguments
    if [ "$#" -eq 0 ]; then
        echo "Usage: make_directory <directory1> [<directory2> ...]" >&2
        return 1
    fi

    if ! check_home_dir; then
        return 0
    fi

    for dir in "$@"; do
        # Check if the directory already exists.
        if [ -d "$dir" ]; then
            echo "Directory '$dir' already exists."
        else
            # Create the directory if it doesn't exist.
            echo "Creating directory: '$dir'"
            mkdir -p "$dir"
            if [ $? -ne 0 ]; then
                echo "Error: Failed to create directory '$dir'." >&2
                echo "Skipping to next directory..." >&2
                continue
            fi
        fi
    done
}
