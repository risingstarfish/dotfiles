# --- 8-bit (256-Color) ANSI Color Codes (in ~/.zshrc) ---

# Reset all attributes
export COLOUR_RESET="\e[0m"

# --- Basic 16 Colors (often mapped to 0-15 in the 256-color palette) ---
# Normal
export COLOUR_BLACK="\e[38;5;0m"
export COLOUR_RED="\e[38;5;1m"
export COLOUR_GREEN="\e[38;5;2m"
export COLOUR_YELLOW="\e[38;5;3m"
export COLOUR_BLUE="\e[38;5;4m"
export COLOUR_MAGENTA="\e[38;5;5m"
export COLOUR_CYAN="\e[38;5;6m"
export COLOUR_WHITE="\e[38;5;7m"

# Bright/Bold (often mapped to 8-15)
export COLOUR_BRIGHT_BLACK="\e[38;5;8m"   # Dark Grey
export COLOUR_BRIGHT_RED="\e[38;5;9m"
export COLOUR_BRIGHT_GREEN="\e[38;5;10m"
export COLOUR_BRIGHT_YELLOW="\e[38;5;11m"
export COLOUR_BRIGHT_BLUE="\e[38;5;12m"
export COLOUR_BRIGHT_MAGENTA="\e[38;5;13m"
export COLOUR_BRIGHT_CYAN="\e[38;5;14m"
export COLOUR_BRIGHT_WHITE="\e[38;5;15m"

# --- More Colors from the 256-color palette (common choices) ---
# Color Cube (starts from 16, typically 216 colors from 16-231)
# These are a selection; you can pick specific numbers from a 256-color chart.
export COLOUR_ORANGE="\e[38;5;208m"    # A vibrant orange
export COLOUR_PURPLE="\e[38;5;129m"    # A nice purple
export COLOUR_PINK="\e[38;5;206m"      # A bright pink
export COLOUR_LIME_GREEN="\e[38;5;46m" # A very bright green
export COLOUR_DEEP_BLUE="\e[38;5;21m"  # A rich blue (from 0-255 range)
export COLOUR_TEAL="\e[38;5;37m"       # A teal/turquoise color

# Grayscale colors (232-255)
export COLOUR_GREY_0="\e[38;5;248m"    # Light grey
export COLOUR_GREY_1="\e[38;5;242m"    # Grey
export COLOUR_GREY_2="\e[38;5;238m"    # Dark grey

# --- Common Text Attributes ---
export STYLE_BOLD="\e[1m"
export STYLE_UNDERLINE="\e[4m"

 





# --- Function to display all defined colours ---
# This function acts like an alias. It iterates through all environment
# variables starting with 'COLOUR_', filters out the non-color attributes,
# and prints each color name followed by a sample text in that color.
colours() {
    echo "---------------- Defined Terminal Colours ----------------"
    for var_name in $(env | grep '^COLOUR_' | cut -d'=' -f1 | grep -v -E 'RESET|BOLD|UNDERLINE|INVERT'); do
        local color_code="${(P)var_name}"
       
        # Extract the color index from the escape code using zsh parameter substitution.
        # This gets the number between the last ';' and the 'm'.
        local color_index=${color_code##*;}
        color_index=${color_index%m}
       
        # Use printf to format the output neatly in columns
        printf "%-25s %bSample text%b \t\tcode: %s\n" "${var_name}" "${color_code}" "${COLOUR_RESET}" "$color_index"
    done
    echo "----------------------------------------------------------"
}




# --- Function to print text with a specified color ---
# Usage 1 (by variable name): cprint "COLOUR_BRIGHT_GREEN" "Success!"
# Usage 2 (by variable value): cprint "$COLOUR_RED" "Error!"
colour_print() {
    # Check if enough arguments are provided
    if [ "$#" -ne 2 ]; then
        echo "Usage: cprint \"COLOR_VARIABLE | \$COLOR_VARIABLE\" \"Your text here\"" >&2
        return 1
    fi

    local arg1="$1"
    local text_to_print="$2"
    local color_code

    # Check if the first argument is a direct escape code or a variable name.
    # If it starts with '\e', we assume it's the code itself (e.g., from "$COLOUR_RED").
    # Otherwise, we assume it's the name of the variable (e.g., from "COLOUR_RED").
    if [[ "$arg1" == '\e'* ]]; then
        color_code="$arg1"
    else
        # It's a name, so we use indirect expansion to get the value.
        color_code="${(P)arg1}"
    fi
   
    # Check if we ended up with a valid color code
    if [ -z "$color_code" ]; then
        echo "Error: Color variable '$arg1' not found or is empty." >&2
        # Fallback to printing the text without color
        echo "$text_to_print"
        return 1
    fi

    # Use printf to print the colored text, followed by a reset code.
    printf "%b%b%b\n" "${color_code}" "${text_to_print}" "${COLOUR_RESET}"
}
