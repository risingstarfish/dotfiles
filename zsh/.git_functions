#!/usr/bin/env zsh

# git add, commit
function gac() {
	local message="$1"

	if [[ -n "$message" ]]; then
		git add .
		git commit -m "$message"
	else
		echo "Error: Commit message is not provided"
		echo "Usage: gac \"Your commit message here\""
	fi
}

# git add, commit, push
function gacp() {
	local message="$1"
	local currBranch=$(git symbolic-ref --short -q HEAD)

	if [[ -n "$message" ]]; then
		git add -A
		git commit -m "$message"
		git push origin "$currBranch"
	else
		echo "Error: Commit message is not provided"
		echo "Usage: gacp \"Your commit message here\""
	fi
}
