{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    // Base
    {
      "hidden": true,
      "name": "Base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_C_STANDARD": "17",
        "CMAKE_C_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/${presetName}/bin",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/${presetName}/lib",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/build/${presetName}/lib",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_FLAGS": "-march=native",
        "CMAKE_CXX_STANDARD": "23"
        //
      },
      "environment": {}
    },
    // Debug and Release Base
    {
      "hidden": true,
      "inherits": "Base",
      "name": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "hidden": true,
      "inherits": "Base",
      "name": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    // GCC Trunk
    {
      "hidden": true,
      "name": "GCC Trunk",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{GCC_TRUNK}/bin/gcc",
        "CMAKE_CXX_COMPILER": "$env{GCC_TRUNK}/bin/g++"
      }
    },
    {
      "inherits": ["GCC Trunk", "Debug"],
      "name": "GCC Trunk Debug",
      "displayName": "GCC Trunk Debug",
      "description": "Configures Debug build for GCC Trunk"
    },
    {
      "inherits": ["GCC Trunk", "Release"],
      "name": "GCC Trunk Release",
      "displayName": "GCC Trunk Release",
      "description": "Configures Release build for GCC Trunk"
    },
    // Clang-p2996
    {
      "hidden": true,
      "name": "Clang-p2996",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{CLANG_P2996}/bin/clang",
        "CMAKE_CXX_COMPILER": "$env{CLANG_P2996}/bin/clang++"
      }
    },
    {
      "inherits": ["Clang-p2996", "Debug"],
      "name": "Clang-p2996 Debug",
      "displayName": "Clang-p2996 Debug",
      "description": "Configures Debug build for Clang-p2996"
    },
    {
      "inherits": ["Clang-p2996", "Release"],
      "name": "Clang-p2996 Release",
      "displayName": "Clang-p2996 Release",
      "description": "Configures Release build for Clang-p2996"
    },
    // Clang Trunk
    {
      "hidden": true,
      "name": "Clang Trunk",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{CLANG_TRUNK}/bin/clang",
        "CMAKE_CXX_COMPILER": "$env{CLANG_TRUNK}/bin/clang++"
      }
    },
    {
      "inherits": ["Clang Trunk", "Debug"],
      "name": "Clang Trunk Debug",
      "displayName": "Clang Trunk Debug",
      "description": "Configures Debug build for Clang Trunk"
    },
    {
      "inherits": ["Clang Trunk", "Release"],
      "name": "Clang Trunk Release",
      "displayName": "Clang Trunk Release",
      "description": "Configures Release build for Clang Trunk"
    }
  ],
  "buildPresets": [
    // GCC
    {
      "name": "GCC Trunk Debug",
      "displayName": "GCC Trunk Debug Build",
      "description": "Configures Debug build for GCC Trunk",
      "configurePreset": "GCC Trunk Debug"
    },
    {
      "name": "GCC Trunk Release",
      "displayName": "GCC Trunk Release Build",
      "description": "Configures Release build for GCC Trunk",
      "configurePreset": "GCC Trunk Release"
    },
    // Clang-p2996
    {
      "name": "Clang-p2996 Debug",
      "displayName": "Clang-p2996 Debug Build",
      "description": "Configures Debug build for Clang-p2996",
      "configurePreset": "Clang-p2996 Debug"
    },
    {
      "name": "Clang-p2996 Release",
      "displayName": "Clang-p2996 Release Build",
      "description": "Configures Release build for Clang-p2996",
      "configurePreset": "Clang-p2996 Release"
    },
    // Clang Trunk
    {
      "name": "Clang Trunk Debug",
      "displayName": "Clang Trunk Debug Build",
      "description": "Configures Debug build for Clang Trunk",
      "configurePreset": "Clang Trunk Debug"
    },
    {
      "name": "Clang Trunk Release",
      "displayName": "Clang Trunk Release Build",
      "description": "Configures Release build for Clang Trunk",
      "configurePreset": "Clang Trunk Release"
    }
  ]
}
