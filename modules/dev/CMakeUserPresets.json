    },
    {
      "name": "mac-homebrew-gcc-debug-ubsan",
      "displayName": "GCC (macOS brew) [Debug][UBSAN]",
      "description": "System GCC on macOS with Undefined sanitiser",
      "inherits": ["debug", "mac-homebrew-gcc", "feature-ubsan"]
    },
    // Combined
    {
      "name": "mac-homebrew-gcc-debug-asan-ubsan",
      "displayName": "GCC (macOS brew) [Debug][ASAN][UBSAN]",
      "description": "System GCC on macOS with Address and Undefined sanitisers",
      "inherits": ["debug", "mac-homebrew-gcc", "feature-asan", "feature-ubsan"]
    },
    {
      "name": "mac-homebrew-gcc-debug-msan-ubsan",
      "displayName": "GCC (macOS brew) [Debug][MSAN][UBSAN]",
      "description": "System GCC on macOS with Memory and Undefined sanitisers",
      "inherits": ["debug", "mac-homebrew-gcc", "feature-msan", "feature-ubsan"]
    },
    {
      "name": "mac-homebrew-gcc-debug-tsan-ubsan",
