    },
    {
      "name": "win-mingw64-debug-msan",
      "displayName": "MinGW64 (Windows) [Debug][MSAN]",
      "description": "GCC on Windows via MinGW64 with Memory sanitiser",
      "inherits": ["debug", "win-mingw64", "feature-msan"]
    },
    {
      "name": "win-mingw64-debug-tsan",
      "displayName": "MinGW64 (Windows) [Debug][TSAN]",
      "description": "GCC on Windows via MinGW64 with Thread sanitiser",
      "inherits": ["debug", "win-mingw64", "feature-tsan"]
    },
    {
      "name": "win-mingw64-debug-ubsan",
      "displayName": "MinGW64 (Windows) [Debug][UBSAN]",
      "description": "GCC on Windows via MinGW64 with Undefined sanitiser",
      "inherits": ["debug", "win-mingw64", "feature-ubsan"]
    },
    // Combined
    {
      "name": "win-mingw64-debug-asan-ubsan",
      "displayName": "MinGW64 (Windows) [Debug][ASAN][UBSAN]",
      "description": "GCC on Windows via MinGW64 with Address and Undefined sanitisers",
      "inherits": ["debug", "win-mingw64", "feature-asan", "feature-ubsan"]
    },
    {
      "name": "win-mingw64-debug-msan-ubsan",
      "displayName": "MinGW64 (Windows) [Debug][MSAN][UBSAN]",
      "description": "GCC on Windows via MinGW64 with Memory and Undefined sanitisers",
      "inherits": ["debug", "win-mingw64", "feature-msan", "feature-ubsan"]
    },
    {
      "name": "win-mingw64-debug-tsan-ubsan",
      "displayName": "MinGW64 (Windows) [Debug][TSAN][UBSAN]",
      "description": "GCC on Windows via MinGW64 with Thread and Undefined sanitisers",
      "inherits": ["debug", "win-mingw64", "feature-tsan", "feature-ubsan"]
    },

    // --- Trunk ---
    // single
    {
      "name": "gcc-trunk-debug-asan",
      "displayName": "GCC Trunk [Debug][ASAN]",
      "description": "Latest GCC development snapshot with Address sanitiser",
      "inherits": ["debug", "gcc-trunk", "feature-asan"]
    },
    {
      "name": "gcc-trunk-debug-msan",
      "displayName": "GCC Trunk [Debug][MSAN]",
      "description": "Latest GCC development snapshot with Memory sanitiser",
      "inherits": ["debug", "gcc-trunk", "feature-msan"]
    },
