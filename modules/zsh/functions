#!/usr/bin/env zsh

# util
{
	# NOTE: zsh index start at 1 !!!???
	function _func_err() {
		local stack="${2:-${funcstack[2]}}"
		printf "%s: %s\n" "${stack}" "${1:-}" >&2
	}

	function _err() {
		printf "Error: %s\n" "${1:-}" >&2
	}

	function _cd() {
		command cd -- "${1}" 2>/dev/null
	}

	function _mkdir() {
		command mkdir "${@}" 2>/dev/null
	}
}

# Create a new directory and enter it
function mkcd() {
	local -a opts=()
	local -r msg="USAGE: mkcd [-pv] [-m mode] directory_name..."
	local target_dir=""

	function mkcd::fail() {
		_func_err "${1}" "${funcstack[2]}"
		printf '%s\n' "${msg:-}" >&2
		return 1
	}

	while [[ $# -gt 0 ]]; do
		case "$1" in
		-p)
			opts+=(-p)
			shift
			;;
		-v)
			opts+=(-v)
			shift
			;;
		-m)
			(($# < 2)) && {
				mkcd::fail "option ${1} requires an argument (e.g. 755)"
				return 1
			}
			opts+=(-m "${2}")
			shift 2
			;;
		-h | --help)
			printf '%s\n' "${msg}"
			return 0
			;;
		-?*)
			mkcd::fail "illegal option ${1}"
			return 1
			;;
		*)
			if [[ -n "${target_dir}" ]]; then
				mkcd::fail 'expected only one directory name'
				return 1
			fi
			target_dir="$1"
			shift
			;;
		esac
	done

	# validate
	if [[ -z "${target_dir}" ]]; then
		_func_err 'no directory name provided'
		printf '%s\n' "${msg}" >&2
		return 1
	fi

	# check if directory exists
	if [[ -d "${target_dir}" ]]; then
		if _cd "${target_dir}"; then
			return 0
		else
			_err "could not change to directory ${target_dir}"
			return 1
		fi
	fi

	# create
	if ! _mkdir "${opts[@]}" -- "${target_dir}"; then
		_err "could not create directory ${target_dir}"
		return 1
	fi
	# enter
	if ! _cd "${target_dir}"; then
		_err "could not change to directory ${target_dir}"
		return 1
	fi

	return 0
}

# https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/cp
# cp function that uses rsync
# The enabled options for rsync are:
#     -p: preserves permissions.
#     -o: preserves owner.
#     -g: preserves group.
#     -b: make a backup of the original file instead of overwriting it, if it exists.
#     -r: recurse directories.
#     -hhh: outputs numbers in human-readable format, in units of 1024 (K, M, G, T).
#     --backup-dir="/tmp/rsync-$USERNAME": move backup copies to "/tmp/rsync-$USERNAME".
#     -e /dev/null: only work on local files (disable remote shells).
#     --progress: display progress.
function cpv() {
	rsync -pogbr -hhh --backup-dir="/tmp/rsync-${USERNAME}" -e /dev/null --progress "$@"
}
compdef _files cpv

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null >/dev/null 2>&1; then
		local arg=-sbh
	else
		local arg=-sh
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@"
	else
		du $arg .[^.]* ./*
	fi
}

# github
{
	# SSH
	# Internal helper function to prompt for email and generate the key
	function _generate_github_ssh_key() {
		local key_type="$1"
		local email="${GITHUB_PUBLIC_EMAIL:-}"

		if [[ -z "$email" ]]; then
			printf '$GITHUB_PUBLIC_EMAIL is unset. Enter GitHub email: '
			read -r email
		else
			printf 'Using $GITHUB_PUBLIC_EMAIL: %s\n' "${GITHUB_PUBLIC_EMAIL}"
		fi

		ssh-keygen -t "$key_type" -C "\"$email\""
	}

	function _git_add() {
		if [[ $# -eq 0 ]]; then
			if ! command git add -A 2>/dev/null; then
				_func_err 'failed to stage changes' "${funcstack[3]}"
				return 1
			fi
		else
			if ! command git add -- "$@" 2>/dev/null; then
				_func_err 'failed to stage paths' "${funcstack[3]}"
				return 1
			fi
		fi
	}

	function _git_commit() {
		if ! command git commit -S -m "${1}" 2>/dev/null; then
			_func_err 'failed to commit changes' "${funcstack[3]}"
			return 1
		fi
	}

	function _git_push() {
		if ! command git push origin "${1}" 2>/dev/null; then
			_func_err "failed to push to origin/${1}." "${funcstack[3]}"
			return 1
		fi
	}

	function _git_current_branch() {
		command git symbolic-ref --short -q HEAD
	}

	function _git_flow() {
		local -r do_push="${1:-0}"
		local -r commit_msg="${2:-}"
		shift 2

		_git_add "${@}" || return 1
		_git_commit "${commit_msg}" || return 1

		# return if not pushing
		[[ "${do_push}" -eq 1 ]] || return 0

		local branch
		branch="$(_git_current_branch)"
		if [[ -z "${branch}" ]]; then
			_func_err 'not on a branch (detached HEAD or not a repo)'
			return 1
		fi

		_git_push "${branch}" || return 1
	}

	# Create a standard ed25519 SSH key for GitHub
	function github_ssh_key() {
		_generate_github_ssh_key "ed25519"
	}

	# Create an ed25519-sk hardware security key for GitHub
	function github_ssh_sk() {
		_generate_github_ssh_key "ed25519-sk"
	}

	# git add <paths>, commit
	function gac() {
		[[ $# -ge 2 && -n "${1}" ]] || {
			printf 'Usage: gac <commit_msg> <paths...>\n' >&2
			return 1
		}
		_git_flow 0 "${1}" "${@:2}"
	}

	# git add <paths>, commit, push
	function gacp() {
		[[ $# -ge 2 && -n "${1}" ]] || {
			printf 'Usage: gacp <commit_msg> <paths...>\n' >&2
			return 1
		}
		_git_flow 1 "${1}" "${@:2}"
	}

	# git add -A, commit
	function gaac() {
		[[ $# -eq 1 && -n "$1" ]] || {
			printf 'Usage: gaac <commit_msg>\n' >&2
			return 1
		}
		_git_flow 0 "$1"
	}

	# git add -A, commit, push
	function gaacp() {
		[[ $# -eq 1 && -n "$1" ]] || {
			printf 'Usage: gaacp <commit_msg>\n' >&2
			return 1
		}
		_git_flow 1 "$1"
	}

}
# compdef
{
	function _compdef_ga() {
		_arguments -s : \
			'1:msg:' \
			'*:paths:_files -/'
	}
	compdef _compdef_ga gac
	compdef _compdef_ga gacp

	function _compdef_gaa() {
		_arguments -s : '1:msg:'
	}
	compdef _compdef_gaa gaac
	compdef _compdef_gaa gaacp
}
