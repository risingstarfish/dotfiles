#!/usr/bin/env zsh

# Create a new directory and enter it
function mkcd() {
	# Check if no arguments are provided
	if [[ -z "$1" ]]; then
		printf 'Usage: mkcd <directory_name>\n'
		printf 'Error: No directory name provided.\n'
		return 1
	fi

	# Check if more than one argument is provided
	if [[ "$" -gt 1 ]]; then
		printf 'Usage: mkcd <directory_name>\n'
		printf 'Error: Too many arguments. Please provide only one directory name.\n'
		return 1
	fi

	local target_dir="$1"

	# Check if the directory already exists
	if [[ -d "$target_dir" ]]; then
		printf 'Directory %s already exists. Changing into it.\n' "${target_dir}"
		if cd "$target_dir"; then
			printf 'Successfully changed to: %s\n' "$(pwd)"
			return 0
		else
			printf 'Error: Could not change to directory %s\n' "${target_dir}"
			return 1
		fi
	fi

	# Attempt to create the directory and then change into it
	if mkdir -p "$target_dir" && cd "$target_dir"; then
		printf 'Successfully created and changed to: %s\n' "$(pwd)"
	else
		printf 'Error: Could not create or change to directory %s.\n' "${target_dir}"
		return 1
	fi
}

# Internal helper function to prompt for email and generate the key
_generate_github_ssh_key() {
	local key_type="$1"
	local email="${GITHUB_PUBLIC_EMAIL:-}"

	if [[ -z "$email" ]]; then
		printf '$GITHUB_PUBLIC_EMAIL is unset. Enter GitHub email: '
		read -r email
	else
		printf 'Using $GITHUB_PUBLIC_EMAIL: %s\n' "${GITHUB_PUBLIC_EMAIL}"
	fi

	ssh-keygen -t "$key_type" -C "\"$email\""
}

# Create a standard ed25519 SSH key for GitHub
github_ssh_key() {
	_generate_github_ssh_key "ed25519"
}

# Create an ed25519-sk hardware security key for GitHub
github_ssh_sk() {
	_generate_github_ssh_key "ed25519-sk"
}

# https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/cp
# cp function that uses rsync
# The enabled options for rsync are:
#     -p: preserves permissions.
#     -o: preserves owner.
#     -g: preserves group.
#     -b: make a backup of the original file instead of overwriting it, if it exists.
#     -r: recurse directories.
#     -hhh: outputs numbers in human-readable format, in units of 1024 (K, M, G, T).
#     --backup-dir="/tmp/rsync-$USERNAME": move backup copies to "/tmp/rsync-$USERNAME".
#     -e /dev/null: only work on local files (disable remote shells).
#     --progress: display progress.
cpv() {
	rsync -pogbr -hhh --backup-dir="/tmp/rsync-${USERNAME}" -e /dev/null --progress "$@"
}
compdef _files cpv

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null >/dev/null 2>&1; then
		local arg=-sbh
	else
		local arg=-sh
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@"
	else
		du $arg .[^.]* ./*
	fi
}

# git add, commit
function gac() {
	local message="$1"

	if [[ -n "$message" ]]; then
		git add .
		git commit -S -m "$message"
	else
		echo "Error: Commit message is not provided"
		echo "Usage: gac \"Your commit message here\""
	fi
}

# git add, commit, push
function gacp() {
	local message="$1"
	local currBranch=$(git symbolic-ref --short -q HEAD)

	if [[ -n "$message" ]]; then
		git add -A
		git commit -S -m "$message"
		git push origin "$currBranch"
	else
		echo "Error: Commit message is not provided"
		echo "Usage: gacp \"Your commit message here\""
	fi
}
