# Base style and language settings
BasedOnStyle: LLVM
Language: Cpp
Standard: Auto

# Indentation and spacing
IndentWidth: 4
TabWidth: 4
UseTab: ForContinuationAndIndentation
ContinuationIndentWidth: 2
AccessModifierOffset: -4

# Line length and wrapping
ColumnLimit: 100
AlignAfterOpenBracket: true
AlignEscapedNewlines: Left
AlignOperands: AlignAfterOperator
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 1
  AlignPPAndNotPP: false

# Alignment of consecutive items
AlignConsecutiveMacros: true
AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
  AlignCompound: true
  PadOperators: true
AlignConsecutiveDeclarations:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: true
  AlignFunctionDeclarations: true
  AlignFunctionPointers: false

EnumTrailingComma: Leave

# Function and parameter formatting
AlwaysBreakAfterReturnType: None
AlwaysBreakBeforeMultilineStrings: false
AlwaysBreakTemplateDeclarations: Yes
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeBraces: Custom
BreakConstructorInitializers: AfterColon
BreakInheritanceList: AfterColon
BreakStringLiterals: true
AllowBreakBeforeNoexceptSpecifier: OnlyWithParen
BinPackArguments: false
BinPackParameters: false
BinPackLongBracedList: false
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true

# Constructor and initializer formatting
AllowAllConstructorInitializersOnNextLine: true
ConstructorInitializerAllOnOneLineOrOnePerLine: true
ConstructorInitializerIndentWidth: 2
SpaceBeforeCtorInitializerColon: true

# Control structure formatting
IndentCaseLabels: true
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: true
AllowShortCaseExpressionOnASingleLine: true
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortCompoundRequirementOnASingleLine: true
AllowShortLoopsOnASingleLine: true
AllowShortEnumsOnASingleLine: true
AllowShortNamespacesOnASingleLine: false
AllowShortLambdasOnASingleLine: Empty
SpaceBeforeParens: ControlStatements

RemoveEmptyLinesInUnwrappedLines: true
IndentWrappedFunctionNames: true

# Namespace formatting
CompactNamespaces: false
FixNamespaceComments: true
NamespaceIndentation: None

# Include and using declarations
SortIncludes: true
IncludeBlocks: Preserve
SortUsingDeclarations: false

# Preprocessor directives
IndentPPDirectives: AfterHash

# Pointer and reference alignment
DerivePointerAlignment: false
PointerAlignment: Right
ReferenceAlignment: Right

# Spaces and parentheses
SpaceAfterCStyleCast: true
SpaceAfterLogicalNot: false
SpaceAfterTemplateKeyword: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeCpp11BracedList: true
SpaceBeforeInheritanceColon: true
SpaceBeforeRangeBasedForLoopColon: true
SpaceInEmptyParentheses: false
SpacesBeforeTrailingComments: 2
SpacesInAngles: false
SpacesInCStyleCastParentheses: false
SpacesInContainerLiterals: false
SpacesInParentheses: false
SpacesInSquareBrackets: false

# Alignment of qualifiers
QualifierAlignment: Custom
QualifierOrder:
  [friend, static, inline, constexpr, const, volatile, restrict, type]

# Comment formatting
ReflowComments: IndentOnly

# Empty line handling
KeepEmptyLinesAtTheStartOfBlocks: true
MaxEmptyLinesToKeep: 2 # 1 + OverEmptyLines

# Objective-C specific
ObjCBinPackProtocolList: Auto
AlignArrayOfStructures: Right

InsertTrailingCommas: Wrapped
RequiresClausePosition: OwnLine
IndentRequiresClause: true
