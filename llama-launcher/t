{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llama-launcher configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "minimum": 1
    },
    "general": {
      "$ref": "#/$defs/general"
    },
    "network": {
      "$ref": "#/$defs/network"
    },
    "ui": {
      "$ref": "#/$defs/ui"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "env": {
      "$ref": "#/$defs/env"
    },
    "models": {
      "$ref": "#/$defs/models"
    },
    "hardware": {
      "$ref": "#/$defs/hardware"
    },
    "profiles": {
      "$ref": "#/$defs/profiles"
    }
  },
  "required": [
    "version",
    "general",
    "network",
    "ui",
    "runtime",
    "models",
    "profiles"
  ],
  "additionalProperties": false,
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "keyArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/key"
      },
      "uniqueItems": true
    },
    "envMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "host",
        "port"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "default": {
          "$ref": "#/$defs/endpoint"
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/endpoint"
          }
        }
      },
      "required": [
        "default"
      ],
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "colour": {
          "enum": [
            "auto",
            "truecolor",
            "xterm",
            "ansi",
            "always",
            "never"
          ]
        },
        "display_centered": {
          "type": "boolean"
        },
        "auto_close": {
          "type": "boolean"
        },
        "sort_alphabetically": {
          "type": "boolean"
        },
        "refresh_seconds": {
          "type": "number",
          "minimum": 1
        },
        "memory_status": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "format": {
              "type": "string"
            },
            "bar": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                },
                "colour": {
                  "type": "string",
                  "minLength": 1
                },
                "background": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "width",
                "colour",
                "background"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "enabled",
            "format"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "colour",
        "display_centered",
        "auto_close",
        "sort_alphabetically",
        "refresh_seconds",
        "memory_status"
      ],
      "additionalProperties": false
    },
    "samplingParams": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "repeat_penalty": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "top_k": {
          "type": "integer",
          "minimum": 0
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "runtimeParams": {
      "type": "object",
      "properties": {
        "gpu_layers": {
          "type": "integer",
          "minimum": 0
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "threads_batch": {
          "type": "integer",
          "minimum": 1
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "context_size": {
          "type": "integer",
          "minimum": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "flash_attn": {
          "type": "boolean"
        },
        "cont_batching": {
          "type": "boolean"
        },
        "parallel": {
          "type": "integer",
          "minimum": 1
        },
        "mlock": {
          "type": "boolean"
        },
        "no_mmap": {
          "type": "boolean"
        },
        "embedding": {
          "type": "boolean"
        },
        "jinja": {
          "type": "boolean"
        },
        "sampling": {
          "$ref": "#/$defs/samplingParams"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "defaults": {
          "$ref": "#/$defs/runtimeParams"
        },
        "templates": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/runtimeParams"
          }
        }
      },
      "required": [
        "defaults",
        "templates"
      ],
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "properties": {
        "defaults": {
          "$ref": "#/$defs/envMap"
        },
        "presets": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/envMap"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "defaults",
        "presets"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "title",
        "path"
      ],
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "device": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "index"
      ],
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "properties": {
        "device": {
          "$ref": "#/$defs/key"
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "main_device": {
          "$ref": "#/$defs/key"
        },
        "tensor_split": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 1
        },
        "split_mode": {
          "enum": [
            "layer",
            "row",
            "tensor"
          ]
        }
      },
      "required": [
        "tensor_split",
        "split_mode"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "device"
          ],
          "not": {
            "required": [
              "devices"
            ]
          }
        },
        {
          "required": [
            "devices"
          ],
          "not": {
            "required": [
              "device"
            ]
          }
        }
      ]
    },
    "hardware": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/device"
          },
          "minProperties": 1
        },
        "placements": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/placement"
          },
          "minProperties": 1
        }
      },
      "required": [
        "devices",
        "placements"
      ],
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "model": {
          "$ref": "#/$defs/key"
        },
        "placement": {
          "$ref": "#/$defs/key"
        },
        "template": {
          "$ref": "#/$defs/key"
        },
        "network_slot": {
          "$ref": "#/$defs/key"
        },
        "env_presets": {
          "$ref": "#/$defs/keyArray"
        },
        "env": {
          "$ref": "#/$defs/envMap"
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "model"
      ],
      "additionalProperties": false
    },
    "shared": {
      "type": "object",
      "properties": {
        "template": {
          "$ref": "#/$defs/key"
        },
        "env_presets": {
          "$ref": "#/$defs/keyArray"
        },
        "env": {
          "$ref": "#/$defs/envMap"
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "favourite": {
          "type": "boolean"
        },
        "shared": {
          "$ref": "#/$defs/shared"
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instance"
          },
          "minItems": 1
        }
      },
      "required": [
        "title",
        "instances"
      ],
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "general": {
      "type": "object",
      "properties": {
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "model_dir": {
          "type": "string",
          "minLength": 1
        },
        "log_dir": {
          "type": "string",
          "minLength": 1
        },
        "cache_dir": {
          "type": "string",
          "minLength": 1
        },
        "state_dir": {
          "type": "string",
          "minLength": 1
        },
        "auto_stop_server": {
          "type": "boolean"
        },
        "auto_unload": {
          "type": "boolean"
        },
        "log_retention_day": {
          "type": "integer",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "min_uptime_sec": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "binary",
        "model_dir",
        "log_dir",
        "cache_dir",
        "auto_stop_server",
        "auto_unload",
        "log_retention_day",
        "max_retries",
        "min_uptime_sec"
      ],
      "additionalProperties": false
    }
  }
}
